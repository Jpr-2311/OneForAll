# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `npx supabase status` after `npm run db:start`.

# Public: safe to expose to the browser. Access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute app origin, used to build auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets. Do NOT prefix with NEXT_PUBLIC_. Not used in Phase 1.
# SUPABASE_SECRET_KEY=
